{
	"app_name": "vitraj",
	"version": "1.7.4-SNAPSHOT",
	"author": "Michael Herrmann",
	"author_email": "michael+removethisifyouarehuman@herrmann.io",
	"description": "A modern file manager for power users. Beautiful, fast and extensible",
	"url": "https://fman.io",
	"main_module": "src/main/python/vitraj/main.py",
	"freeze_dir": "target/${app_name}",
	"test_dirs": [
		"src/main/resources/base/Plugins/Core"
	],
	"release": false,
	"environment": "local",
	"server_url": "http://127.0.0.1:8000",
	"files_to_filter": [
		"src/build/docker/arch/Dockerfile",
		"src/build/docker/ubuntu/Dockerfile",
		"src/build/docker/fedora/Dockerfile",
		"src/build/docker/fedora/.rpmmacros"
	],
	"public_settings": ["environment", "server_url"],
	"core_plugin_in_freeze_dir": "${freeze_dir}/Plugins/Core",
	"docker_images": {
		"arch": {
			"build_files": [
				"requirements/"
			]
		},
		"ubuntu": {
			"build_files": [
				"requirements/"
			]
		},
		"fedora": {
			"build_files": [
				"requirements/"
			]
		}
	},
	"hidden_imports": ["requests", "fitz", "pymupdf", "PIL", "Foundation", "send2trash"]
}