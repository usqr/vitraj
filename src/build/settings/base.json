	"release": false,
	"environment": "local",
	"server_url": "http://127.0.0.1:8000",
	"public_settings": ["app_name", "author", "version", "environment", "server_url"],
	"core_plugin_in_freeze_dir": "${freeze_dir}/Plugins/Core",
	"extra_pyinstaller_args": [],

